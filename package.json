{
  "name": "rustchamber-www",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:worker": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check": "svelte-check --tsconfig ./tsconfig.app.json",
    "assets:sync": "node --env-file=.env scripts/assets/sync.mjs",
    "assets:sync:dry": "node --env-file=.env scripts/assets/sync.mjs --dry-run",
    "assets:verify": "node --env-file-if-exists=.env scripts/assets/verify.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "^1.68.0",
    "motion": "^14.9.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "wrangler": "^4.158.0"
  }
}
